---
import { researchEditorial } from '../data/research-editorial';
import EditorialStatement from '../components/EditorialStatement.astro';
import { editorialQuotes } from '../data/editorial-quotes';
import BrandBanner from '../components/BrandBanner.astro';
import PublicationEmblem from '../components/PublicationEmblem.astro';
import { brand } from '../data/brand-assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/urls';
---

<BaseLayout
  title="About the publication"
  description="TheJobPoolConsultants publishes clear, technically meaningful explanations of artificial intelligence, engineering, and research."
>
  <div class="page-hero about-hero">
    <div class="about-publication-identity">
      <PublicationEmblem decorative />
      <div>
        <strong>{brand.name}</strong>
        <span class="meta">{brand.descriptor}</span>
      </div>
    </div>
    <h1>
      Technology changes quickly.
      <br />
      Understanding shouldn’t feel impossible.
    </h1>
    <p class="lead">
      We’re building a public knowledge library for people who want to
      understand how intelligent systems work—and how to build with them.
    </p>
  </div>
  <div class="split section">
    <div>
      <EditorialStatement
        quote={editorialQuotes.signature}
        variant="inline"
        label="Publication philosophy"
      />
      <p class="lead">
        Machine learning, deep learning, language, generative AI, and agents
        belong to a connected landscape. Classical methods and new architectures
        both have a place here.
      </p>
      <a class="text-link" href={url('topics/')}>
        Explore the knowledge map →
      </a>
    </div>
    <div class="prose">
      <h2>Our editorial values</h2>
      <p>
        <strong>Clarity.</strong> Explain a difficult idea without stripping
        away what makes it useful.
      </p>
      <p>
        <strong>Evidence.</strong> Never make the explanation stronger than the
        evidence. {researchEditorial.approach}
      </p>
      <p>
        <strong>Practicality.</strong> Connect mechanisms to decisions an
        engineer can make.
      </p>
      <p>
        <strong>Curiosity.</strong> End with a worthwhile next question.
      </p>
      <p>
        <strong>Depth.</strong> Offer a route from intuition to the mathematics,
        code, and trade-offs.
      </p>
    </div>
  </div>
  <section class="section" aria-labelledby="connected-ideas">
    <p class="eyebrow">A connected view</p>
    <h2 id="connected-ideas">From concepts to systems.</h2>
    <p class="lead">
      Data, context, memory, action and feedback belong to the same picture.
      Explore the mechanisms behind them in our topic guides.
    </p>
    <BrandBanner kind="intelligence" />
    <a class="text-link" href={url('topics/')}>
      Explore the topic guides →
    </a>
  </section>
  <section class="section">
    <h2>How to read this library.</h2>
    <p class="lead">
      Starter articles are evergreen explanations. Collections and learning
      paths clearly identify planned coverage. There are no invented
      credentials, audience statistics, or claims of tested production results.
    </p>
    <p class="lead">
      Corrections and contributions are welcome through the{' '}
      <a href="https://github.com/thejobpoolconsultants/blogs">
        public repository
      </a>
      . Technical changes should include sources and a reproducible example
      where appropriate.
    </p>
  </section>
</BaseLayout>
