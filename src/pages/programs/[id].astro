---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramArtwork from '../../components/ProgramArtwork.astro';
import ProgramIllustration from '../../components/ProgramIllustration.astro';
import ProgramLab from '../../components/ProgramLab.astro';
import ComponentInspector from '../../components/ComponentInspector.astro';
import ServiceDependencies from '../../components/ServiceDependencies.astro';
import ProjectBrief from '../../components/ProjectBrief.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { publishedArticles } from '../../utils/content';
import {
  specialistPrograms,
  programsWebsite,
  recommendProgram,
} from '../../data/programs';
import { discovery } from '../../data/program-discovery';
import { url, siteConfig } from '../../utils/urls';
import '../../styles/program-discovery.css';
export async function getStaticPaths() {
  const guides = await getCollection('programGuides');
  return specialistPrograms.map((program) => ({
    params: { id: program.id },
    props: {
      program,
      entry: guides.find((guide) => guide.id === program.icon)!,
    },
  }));
}
const { program, entry } = Astro.props;
const programArticles = (await publishedArticles()).filter(
  (article) => recommendProgram(article.data).id === program.id,
);
const info = discovery[program.icon];
const { Content } = await render(entry);
const diagram =
  program.icon === 'agents'
    ? 'document-assistant'
    : program.icon === 'infrastructure'
      ? 'ai-workload'
      : program.icon === 'cloud'
        ? 'application-access'
        : undefined;
const exercise = [
  'infrastructure',
  'performance',
  'robotics',
  'research',
  'cloud',
  'hardware',
  'deployment',
].includes(program.icon)
  ? program.icon
  : undefined;
const graphic =
  program.icon === 'robotics'
    ? 'navigation-grid'
    : program.icon === 'research'
      ? 'seeded-qlearning'
      : program.icon === 'hardware'
        ? 'roofline-example'
        : undefined;
---

<BaseLayout
  title={program.title}
  description={
    info.sentence + ' Explore a teaching example, project and article draft.'
  }
  noindex
>
  <article class="program-detail" data-pagefind-ignore>
    <a class="text-link" href={url('#programs')}>
      ← All programs
    </a>
    <header class="program-detail-header">
      <div>
        <p class="eyebrow">Program {program.number} · Educational preview</p>
        <h1>{program.title}</h1>
        <p class="intro">{info.sentence}</p>
        <p>{info.audience}</p>
        <p class="muted">
          Current curriculum and admission prerequisites are not published in
          the verified program source. Confirm them with the team.
        </p>
        <div class="program-actions">
          <a
            class="button primary"
            href={siteConfig.enquiryForm}
            target="_blank"
            rel="noopener noreferrer"
          >
            Enquire about this program ↗
          </a>
          <a
            class="text-link"
            href={programsWebsite}
            target="_blank"
            rel="noopener noreferrer"
          >
            Main website programs ↗
          </a>
        </div>
      </div>
      <ProgramArtwork kind={program.icon} priority />
    </header>
    <section
      id="articles"
      class="detail-section"
      aria-labelledby="program-articles-title"
    >
      <p class="eyebrow">Free educational reading</p>
      <h2 id="program-articles-title">
        Explore this program through articles.
      </h2>
      <p class="muted">
        {programArticles.length} published{' '}
        {programArticles.length === 1 ? 'article' : 'articles'} · Reading times
        are calculated from the content.
      </p>
      {programArticles.length ? (
        <div class="article-grid">
          {programArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <p>
          Coming soon. Explore the teaching examples and exercises below while
          full articles are prepared.
        </p>
      )}
      <a class="text-link" href={url('articles/') + '?program=' + program.id}>
        Browse and filter articles →
      </a>
    </section>
    <section class="detail-section" aria-labelledby="mechanism-title">
      <p class="eyebrow">Understand the work</p>
      <h2 id="mechanism-title">One example, step by step.</h2>
      <ol class="workflow-steps">
        {info.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <div class="teaching-grid">
        <div>
          {(program.icon === 'infrastructure' ||
            program.icon === 'hardware') && (
            <ComponentInspector kind={program.icon} />
          )}
          {(program.icon === 'cloud' || program.icon === 'leadership') && (
            <ServiceDependencies kind={program.icon} />
          )}
          <ProgramLab kind={program.icon} />
        </div>
        <div>
          {program.icon === 'leadership' || program.icon === 'deployment' ? (
            <ProjectBrief kind={program.icon} />
          ) : (
            <ProgramIllustration kind={program.icon} number={program.number} />
          )}
          {program.icon === 'robotics' && (
            <p class="chart-note">
              The editable SVG demonstrates a sorting arm; the navigation
              scenario separately models a mobile robot. Both are simplified
              examples.
            </p>
          )}
          {diagram && (
            <a
              class="text-link"
              href={url('diagrams/' + diagram + '.html')}
              target="_blank"
              rel="noopener noreferrer"
            >
              Explore the system diagram ↗
            </a>
          )}
        </div>
      </div>
    </section>
    <section
      class="detail-section"
      id="article"
      aria-labelledby="article-title"
    >
      <div class="article-draft">
        <p class="draft-label">
          Article draft · Awaiting editorial publication
        </p>
        <h2 id="article-title">{info.article}</h2>
        <Content />
        {graphic && (
          <p>
            <a
              class="text-link"
              href={url('illustrations/program-guides/' + graphic + '.svg')}
              download
            >
              Download the editable graph SVG ↓
            </a>
          </p>
        )}
        {program.icon === 'research' && (
          <p>
            <a
              class="text-link"
              href={url('examples/programs/q-learning-seed17.json')}
              download
            >
              Download the recorded learning data ↓
            </a>
          </p>
        )}
        {exercise && (
          <p>
            <a
              class="button"
              href={url('examples/programs/' + exercise + '.py')}
              download
            >
              Download the CPU exercise ↓
            </a>
          </p>
        )}
      </div>
    </section>
    <section class="detail-section" id="project">
      <p class="eyebrow">Project example</p>
      <h2>Build evidence of your understanding.</h2>
      <p>{info.project}</p>
      <p>
        Keep the inputs, assumptions, source references, expected behavior,
        observed results and limitations together. This is an educational
        project suggestion, not a verified course deliverable.
      </p>
      <div class="program-actions">
        <a
          class="button primary"
          href={siteConfig.enquiryForm}
          target="_blank"
          rel="noopener noreferrer"
        >
          Discuss the pathway ↗
        </a>
        <a class="text-link" href={url('learn/')}>
          Explore free learning paths →
        </a>
      </div>
    </section>
  </article>
</BaseLayout>
