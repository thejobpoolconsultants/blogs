---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramArtwork from '../../components/ProgramArtwork.astro';
import ProgramLab from '../../components/ProgramLab.astro';
import { starterGuides } from '../../data/program-discovery';
import { url, siteConfig } from '../../utils/urls';
import '../../styles/program-discovery.css';
export async function getStaticPaths() {
  const guides = await getCollection('programGuides');
  return starterGuides.map((guide) => ({
    params: { id: guide.id },
    props: { guide, entry: guides.find((entry) => entry.id === guide.id)! },
  }));
}
const { guide, entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={guide.title} description={guide.description} noindex>
  <article class="program-detail" data-pagefind-ignore>
    <a class="text-link" href={url('#transition-program-title')}>
      ← Start with foundations
    </a>
    <header class="program-detail-header">
      <div>
        <p class="draft-label">Starter article draft · Editorial preview</p>
        <h1>{guide.title}</h1>
        <p class="intro">{guide.description}</p>
      </div>
      <ProgramArtwork kind={guide.kind} priority />
    </header>
    <div class="article-draft">
      <Content />
      <ProgramLab kind={guide.kind} />
      <div class="program-actions">
        <a
          class="button primary"
          href={siteConfig.enquiryForm}
          target="_blank"
          rel="noopener noreferrer"
        >
          Get career guidance ↗
        </a>
        <a class="text-link" href={url('learn/')}>
          Explore free learning paths →
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
