---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { series } from '../../data/series';
import { publishedArticles } from '../../utils/content';
import { topicById } from '../../data/topics';
import { url } from '../../utils/urls';
export function getStaticPaths() {
  return series.map((collection) => ({
    params: { series: collection.id },
    props: { collection },
  }));
}
const { collection } = Astro.props;
const articles = (await publishedArticles())
  .filter((a) => a.data.series === collection.id)
  .sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));
---

<BaseLayout title={collection.title} description={collection.description}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url('series/')}>Series</a>
    <span>/</span>
    <span aria-current="page">{collection.title}</span>
  </nav>
  <div class="page-hero">
    <p class="eyebrow">The collection</p>
    <h1>{collection.title}</h1>
    <p class="lead">{collection.description}</p>
    <p class="muted">
      For: {collection.audience}
      <br />
      Prerequisites: {collection.prerequisites}
    </p>
    <span class="meta">
      {articles.length} published · Read in the order below
    </span>
  </div>
  <ArticleList
    articles={articles}
    empty="This collection is planned. No articles have been published in it yet."
  />
  {articles[0] && (
    <a
      class="button primary"
      style="margin-top:30px"
      href={url('articles/' + articles[0].data.slug + '/')}
    >
      Start with the first article →
    </a>
  )}
  <section class="section">
    <h2>Explore the wider idea.</h2>
    <a class="text-link" href={url('topics/' + collection.topic + '/')}>
      {topicById(collection.topic).title} →
    </a>
  </section>
</BaseLayout>
