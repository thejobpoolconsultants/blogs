---
import { render } from 'astro:content';
import ResearchEditorialNote from '../../components/ResearchEditorialNote.astro';
import {
  researchEditorial,
  isPaperBased,
  articleTypeLabel,
} from '../../data/research-editorial';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProgramRecommendation from '../../components/ProgramRecommendation.astro';
import { publishedArticles, readingTime, dateLabel } from '../../utils/content';
import { topicNavigation } from '../../utils/topic-navigation';
import TopicReaderLayout from '../../components/knowledge/TopicReaderLayout.astro';
import ArticleBreadcrumbs from '../../components/knowledge/ArticleBreadcrumbs.astro';
import ArticleTableOfContents from '../../components/knowledge/ArticleTableOfContents.astro';
import ArticlePreviousNext from '../../components/knowledge/ArticlePreviousNext.astro';
import { topicById } from '../../data/topics';
import { series } from '../../data/series';
import { insideAiSeriesId } from '../../data/inside-ai-systems';
import { authors } from '../../data/authors';
import { tagSlug } from '../../data/tags';
import { absoluteUrl, url, siteConfig } from '../../utils/urls';
export async function getStaticPaths() {
  return (await publishedArticles()).map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const data = article.data;
const paperBased = isPaperBased(data);
const primarySources = data.sources.filter(
  (source) => source.role === 'primary',
);
const supportingSources = data.sources.filter(
  (source) => source.role === 'supporting',
);
const all = await publishedArticles();
const topic = topicById(data.topic);
const navigation = topicNavigation(data.topic, all);
const articleSection = navigation.sections.find((section) =>
  section.articles.some((entry) => entry.slug === data.slug),
)!;
const collection = series.find((s) => s.id === data.series);
const siblings = all
  .filter((a) => a.data.series === data.series && data.series)
  .sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));
const position = siblings.findIndex((a) => a.id === article.id);
const related = all.filter((a) => data.relatedArticles.includes(a.data.slug));
const canonical = absoluteUrl('articles/' + data.slug + '/');
const json = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: data.title,
      description: data.description,
      datePublished: data.publishedAt.toISOString(),
      dateModified: (data.updatedAt || data.publishedAt).toISOString(),
      mainEntityOfPage: canonical,
      image: absoluteUrl('social/' + data.slug + '.png'),
      author: data.authors.map((id) => ({
        '@type': 'Organization',
        name: authors.find((a) => a.id === id)!.name,
        url: absoluteUrl('authors/' + id + '/'),
      })),
      publisher: {
        '@type': 'Organization',
        name: siteConfig.name,
        url: absoluteUrl(),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Knowledge Library', item: absoluteUrl('topics/') },
        { name: topic.title, item: absoluteUrl(navigation.path) },
        { name: articleSection.title, item: absoluteUrl(articleSection.path) },
        { name: data.title, item: canonical },
      ].map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        ...item,
      })),
    },
  ],
};
---

<BaseLayout
  title={data.seo?.title || data.title}
  description={data.seo?.description || data.description}
  image={'social/' + data.slug + '.png'}
  article
  reader
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(json).replace(/</g, '\\u003c')}
  ></script>
  <ArticleBreadcrumbs
    navigation={navigation}
    section={articleSection}
    title={data.title}
  />
  <TopicReaderLayout
    navigation={navigation}
    selected={articleSection.id}
    current={data.slug}
  >
    <ArticleTableOfContents slot="toc" headings={headings} />
    <article data-pagefind-body data-paper-based={String(paperBased)}>
      <header class="article-header">
        {collection?.id === insideAiSeriesId && (
          <p class="eyebrow">
            <a href={url('series/' + insideAiSeriesId + '/')}>
              Inside AI Systems · Day {data.seriesOrder} of {siblings.length} →
            </a>
          </p>
        )}
        <p class="eyebrow">
          {topic.title} / {articleTypeLabel(data.type)}
        </p>
        <h1 data-pagefind-meta="title">{data.title}</h1>
        <p class="lead" data-pagefind-meta="description">
          {data.subtitle || data.description}
        </p>
        <div class="article-meta">
          {data.authors.map((id) => (
            <a href={url('authors/' + id + '/')}>
              {authors.find((a) => a.id === id)!.name}
            </a>
          ))}
          <span>
            Published{' '}
            <time
              datetime={data.publishedAt.toISOString()}
              data-pagefind-meta="date"
            >
              {dateLabel(data.publishedAt)}
            </time>
          </span>
          {data.updatedAt && (
            <span>
              Updated{' '}
              <time datetime={data.updatedAt.toISOString()}>
                {dateLabel(data.updatedAt)}
              </time>
            </span>
          )}
          <span>Approx. {readingTime(article.body)} min read</span>
          <span>{data.difficulty}</span>
          <span>
            {data.type === 'news-analysis' ? 'News / Analysis' : 'Evergreen'}
          </span>
        </div>
        <div class="pills">
          {data.tags.map((t) => (
            <a class="pill" href={url('tags/' + tagSlug(t) + '/')}>
              {t}
            </a>
          ))}
        </div>
        <span hidden data-pagefind-meta="typeLabel">
          {articleTypeLabel(data.type)}
        </span>
        <span hidden data-pagefind-meta="topic" data-pagefind-filter="Topic">
          {topic.title}
        </span>
        <span hidden data-pagefind-meta="type" data-pagefind-filter="Type">
          {data.type}
        </span>
        <span class="meta muted" style="display:block;margin-top:18px">
          {data.subtopics.join(' · ')}
          {collection ? ' · ' + collection.title : ''}
        </span>
      </header>
      <div class="prose">
        <aside class="callout">
          <strong>What you’ll take away</strong>
          <ul>
            {data.learningOutcomes.map((o) => (
              <li>{o}</li>
            ))}
          </ul>
          <p>
            <strong>Before you begin:</strong> {data.prerequisites.join('; ')}.
          </p>
        </aside>
        {data.hero && (
          <figure>
            <img
              src={url(data.hero.image)}
              alt={data.hero.alt}
              width="1200"
              height="630"
            />
          </figure>
        )}
        <Content />
        <section id="sources" class="sources">
          {[
            { title: 'Primary sources', items: primarySources },
            { title: 'Supporting sources', items: supportingSources },
          ]
            .filter((group) => group.items.length > 0)
            .map((group) => (
              <div class="source-group">
                <h2>{group.title}</h2>
                <ul>
                  {group.items.map((source) => (
                    <li
                      data-source-role={source.role}
                      data-source-kind={source.kind}
                    >
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {source.title} ↗
                      </a>
                      <p class="source-scope">{source.supports}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          <p>
            {paperBased
              ? researchEditorial.sourceNote
              : 'Sources support the technical background. TheJobPoolConsultants examples, diagrams and proposed designs are identified separately.'}
          </p>
        </section>
        {paperBased && <ResearchEditorialNote />}
        <ProgramRecommendation article={data} />
        <div class="share" data-pagefind-ignore>
          <strong>Share this idea</strong>
          <button id="copy-link" data-url={canonical}>
            Copy link
          </button>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={
              'https://www.linkedin.com/sharing/share-offsite/?url=' +
              encodeURIComponent(canonical)
            }
          >
            LinkedIn
          </a>
          <a
            target="_blank"
            rel="noopener noreferrer"
            href={
              'https://twitter.com/intent/tweet?url=' +
              encodeURIComponent(canonical) +
              '&text=' +
              encodeURIComponent(data.title)
            }
          >
            X
          </a>
          <a
            href={
              'mailto:?subject=' +
              encodeURIComponent(data.title) +
              '&body=' +
              encodeURIComponent(canonical)
            }
          >
            Email
          </a>
          <span class="share-status" role="status" id="share-status"></span>
        </div>
        {collection && (
          <section data-pagefind-ignore>
            <p class="eyebrow" style="margin-top:35px">
              Part {position + 1} of {siblings.length} published ·{' '}
              {collection.title}
            </p>
            <a class="text-link" href={url('series/' + collection.id + '/')}>
              Explore this series →
            </a>
            <div class="split">
              {siblings[position - 1] && (
                <a
                  href={url(
                    'articles/' + siblings[position - 1].data.slug + '/',
                  )}
                >
                  ← {siblings[position - 1].data.title}
                </a>
              )}
              {siblings[position + 1] && (
                <a
                  href={url(
                    'articles/' + siblings[position + 1].data.slug + '/',
                  )}
                >
                  {siblings[position + 1].data.title} →
                </a>
              )}
            </div>
          </section>
        )}
        <ArticlePreviousNext navigation={navigation} slug={data.slug} />
      </div>
    </article>
  </TopicReaderLayout>
  <section class="section">
    <h2>Keep the question going.</h2>
    <div class="article-grid">
      {related.map((a) => (
        <ArticleCard article={a} />
      ))}
    </div>
    <a class="text-link" href={url('learn/')}>
      Find your next step in a learning path →
    </a>
  </section>
  <script>
    document
      .querySelector<HTMLButtonElement>('#copy-link')
      ?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const status = document.querySelector<HTMLElement>('#share-status')!;
        try {
          await navigator.clipboard.writeText(button.dataset.url!);
          status.textContent = 'Link copied.';
        } catch {
          status.textContent = 'Copy this address: ' + button.dataset.url;
        }
      });
    document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      const label = document.createElement('span');
      label.textContent =
        pre.dataset.language ||
        pre.querySelector('code')?.className.replace('language-', '') ||
        'Code';
      const button = document.createElement('button');
      button.textContent = 'Copy code';
      button.setAttribute('aria-label', 'Copy code block');
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent || '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select code to copy';
        }
      });
      toolbar.append(label, button);
      pre.before(toolbar);
    });
    document.querySelectorAll('.prose table').forEach((table) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'table-scroll';
      wrapper.tabIndex = 0;
      wrapper.setAttribute('role', 'region');
      wrapper.setAttribute('aria-label', 'Scrollable comparison table');
      table.before(wrapper);
      wrapper.append(table);
    });
  </script>
</BaseLayout>
