---
import { render } from 'astro:content';
import ResearchEditorialNote from '../../components/ResearchEditorialNote.astro';
import {
  researchEditorial,
  isPaperBased,
  articleTypeLabel,
} from '../../data/research-editorial';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { publishedArticles, readingTime, dateLabel } from '../../utils/content';
import { topicSequences, sectionPath } from '../../data/topic-sequences';
import { topicById } from '../../data/topics';
import { series } from '../../data/series';
import { authors } from '../../data/authors';
import { tagSlug } from '../../data/tags';
import { absoluteUrl, url, siteConfig } from '../../utils/urls';
export async function getStaticPaths() {
  return (await publishedArticles()).map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const data = article.data;
const paperBased = isPaperBased(data);
const primarySources = data.sources.filter(
  (source) => source.role === 'primary',
);
const supportingSources = data.sources.filter(
  (source) => source.role === 'supporting',
);
const all = await publishedArticles();
const topic = topicById(data.topic);
const knowledgeEntry = topicSequences
  .flatMap((sequence) =>
    sequence.sections.flatMap((section) =>
      section.concepts
        .filter(
          (concept) =>
            concept.status === 'published' && concept.articleSlug === data.slug,
        )
        .map((concept) => ({ sequence, section, concept })),
    ),
  )
  .at(0);
const collection = series.find((s) => s.id === data.series);
const siblings = all
  .filter((a) => a.data.series === data.series && data.series)
  .sort((a, b) => (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0));
const position = siblings.findIndex((a) => a.id === article.id);
const related = all.filter((a) => data.relatedArticles.includes(a.data.slug));
const canonical = absoluteUrl('articles/' + data.slug + '/');
const json = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: data.title,
      description: data.description,
      datePublished: data.publishedAt.toISOString(),
      dateModified: (data.updatedAt || data.publishedAt).toISOString(),
      mainEntityOfPage: canonical,
      image: absoluteUrl('social/' + data.slug + '.png'),
      author: data.authors.map((id) => ({
        '@type': 'Organization',
        name: authors.find((a) => a.id === id)!.name,
        url: absoluteUrl('authors/' + id + '/'),
      })),
      publisher: {
        '@type': 'Organization',
        name: siteConfig.name,
        url: absoluteUrl(),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: siteConfig.name, item: absoluteUrl() },
        { name: 'Topics', item: absoluteUrl('topics/') },
        { name: topic.title, item: absoluteUrl('topics/' + topic.id + '/') },
        ...(knowledgeEntry
          ? [
              {
                name: knowledgeEntry.section.title,
                item: absoluteUrl(
                  sectionPath(
                    knowledgeEntry.sequence,
                    knowledgeEntry.section.slug,
                  ),
                ),
              },
            ]
          : []),
        { name: data.title, item: canonical },
      ].map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        ...item,
      })),
    },
  ],
};
---

<BaseLayout
  title={data.seo?.title || data.title}
  description={data.seo?.description || data.description}
  image={'social/' + data.slug + '.png'}
  article
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(json).replace(/</g, '\\u003c')}
  ></script>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url()}>Home</a>
    <span>/</span>
    <a href={url('topics/')}>Topics</a>
    <span>/</span>
    <a href={url('topics/' + topic.id + '/')}>{topic.title}</a>
    <span>/</span>
    {knowledgeEntry && (
      <>
        <a
          href={url(
            sectionPath(knowledgeEntry.sequence, knowledgeEntry.section.slug),
          )}
        >
          {knowledgeEntry.section.title}
        </a>
        <span>/</span>
      </>
    )}
    <span aria-current="page">
      {knowledgeEntry?.concept.title || 'Article'}
    </span>
  </nav>
  <article data-pagefind-body data-paper-based={String(paperBased)}>
    <header class="article-header">
      <p class="eyebrow">
        {topic.title} / {articleTypeLabel(data.type)}
      </p>
      <h1 data-pagefind-meta="title">{data.title}</h1>
      <p class="lead" data-pagefind-meta="description">
        {data.subtitle || data.description}
      </p>
      <div class="article-meta">
        {data.authors.map((id) => (
          <a href={url('authors/' + id + '/')}>
            {authors.find((a) => a.id === id)!.name}
          </a>
        ))}
        <span>
          Published{' '}
          <time
            datetime={data.publishedAt.toISOString()}
            data-pagefind-meta="date"
          >
            {dateLabel(data.publishedAt)}
          </time>
        </span>
        {data.updatedAt && (
          <span>
            Updated{' '}
            <time datetime={data.updatedAt.toISOString()}>
              {dateLabel(data.updatedAt)}
            </time>
          </span>
        )}
        <span>Approx. {readingTime(article.body)} min read</span>
        <span>{data.difficulty}</span>
        <span>
          {data.type === 'news-analysis' ? 'News / Analysis' : 'Evergreen'}
        </span>
      </div>
      <div class="pills">
        {data.tags.map((t) => (
          <a class="pill" href={url('tags/' + tagSlug(t) + '/')}>
            {t}
          </a>
        ))}
      </div>
      <span hidden data-pagefind-meta="typeLabel">
        {articleTypeLabel(data.type)}
      </span>
      <span hidden data-pagefind-meta="topic" data-pagefind-filter="Topic">
        {topic.title}
      </span>
      <span hidden data-pagefind-meta="type" data-pagefind-filter="Type">
        {data.type}
      </span>
      <span class="meta muted" style="display:block;margin-top:18px">
        {data.subtopics.join(' · ')}
        {collection ? ' · ' + collection.title : ''}
      </span>
    </header>
    <div class="article-layout">
      <aside class="toc" data-pagefind-ignore>
        <details open>
          <summary>Contents</summary>
          <nav aria-label="Table of contents">
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <a href={'#' + h.slug}>{h.text}</a>
              ))}
            <a href="#sources">Sources</a>
          </nav>
        </details>
      </aside>
      <div class="prose">
        <aside class="callout">
          <strong>What you’ll take away</strong>
          <ul>
            {data.learningOutcomes.map((o) => (
              <li>{o}</li>
            ))}
          </ul>
          <p>
            <strong>Before you begin:</strong> {data.prerequisites.join('; ')}.
          </p>
        </aside>
        {data.hero && (
          <figure>
            <img
              src={url(data.hero.image)}
              alt={data.hero.alt}
              width="1200"
              height="630"
            />
          </figure>
        )}
        <Content />
        <section id="sources" class="sources">
          {[
            { title: 'Primary sources', items: primarySources },
            { title: 'Supporting sources', items: supportingSources },
          ]
            .filter((group) => group.items.length > 0)
            .map((group) => (
              <div class="source-group">
                <h2>{group.title}</h2>
                <ul>
                  {group.items.map((source) => (
                    <li
                      data-source-role={source.role}
                      data-source-kind={source.kind}
                    >
                      <a href={source.url}>{source.title} ↗</a>
                      <p class="source-scope">{source.supports}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          <p>
            {paperBased
              ? researchEditorial.sourceNote
              : 'Sources support the technical background. TheJobPoolConsultants examples, diagrams and proposed designs are identified separately.'}
          </p>
        </section>
        {paperBased && <ResearchEditorialNote />}
        <div class="share" data-pagefind-ignore>
          <strong>Share this idea</strong>
          <button id="copy-link" data-url={canonical}>
            Copy link
          </button>
          <a
            href={
              'https://www.linkedin.com/sharing/share-offsite/?url=' +
              encodeURIComponent(canonical)
            }
          >
            LinkedIn
          </a>
          <a
            href={
              'https://twitter.com/intent/tweet?url=' +
              encodeURIComponent(canonical) +
              '&text=' +
              encodeURIComponent(data.title)
            }
          >
            X
          </a>
          <a
            href={
              'mailto:?subject=' +
              encodeURIComponent(data.title) +
              '&body=' +
              encodeURIComponent(canonical)
            }
          >
            Email
          </a>
          <span class="share-status" role="status" id="share-status"></span>
        </div>
        {collection && (
          <section data-pagefind-ignore>
            <p class="eyebrow" style="margin-top:35px">
              Part {position + 1} of {siblings.length} published ·{' '}
              {collection.title}
            </p>
            <a class="text-link" href={url('series/' + collection.id + '/')}>
              Explore this series →
            </a>
            <div class="split">
              {siblings[position - 1] && (
                <a
                  href={url(
                    'articles/' + siblings[position - 1].data.slug + '/',
                  )}
                >
                  ← {siblings[position - 1].data.title}
                </a>
              )}
              {siblings[position + 1] && (
                <a
                  href={url(
                    'articles/' + siblings[position + 1].data.slug + '/',
                  )}
                >
                  {siblings[position + 1].data.title} →
                </a>
              )}
            </div>
          </section>
        )}
      </div>
      <aside
        class="reading-rail"
        data-pagefind-ignore
        aria-label="Reading context"
      >
        <p class="meta">Your coordinates</p>
        <strong>{topic.title}</strong>
        <dl>
          <dt>Level</dt>
          <dd>{data.difficulty}</dd>
          <dt>Before you begin</dt>
          <dd>{data.prerequisites.join('; ')}</dd>
        </dl>
        {collection && (
          <>
            <p class="meta">In this series</p>
            <a href={url('series/' + collection.id + '/')}>
              {collection.title} ↗
            </a>
          </>
        )}
        <p class="meta">Related concepts</p>
        <div class="rail-concepts">
          {data.subtopics.map((label) => (
            <a href={url('search/') + '?q=' + encodeURIComponent(label)}>
              {label} →
            </a>
          ))}
        </div>
      </aside>
    </div>
  </article>
  <section class="section">
    <h2>Keep the question going.</h2>
    <div class="article-grid">
      {related.map((a) => (
        <ArticleCard article={a} />
      ))}
    </div>
    <a class="text-link" href={url('learn/')}>
      Find your next step in a learning path →
    </a>
  </section>
  <script>
    const contents =
      document.querySelector<HTMLDetailsElement>('.toc details')!;
    const smallScreen = matchMedia('(max-width: 800px)');
    contents.open = !smallScreen.matches;
    smallScreen.addEventListener('change', (event) => {
      contents.open = !event.matches;
    });
    const sections = document.querySelectorAll('.prose h2[id], #sources');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          if (entry.isIntersecting) {
            document.querySelectorAll('.toc a').forEach((link) => {
              if (link.getAttribute('href') === '#' + entry.target.id)
                link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          }
      },
      { rootMargin: '-8% 0px -68% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
    document
      .querySelector<HTMLButtonElement>('#copy-link')
      ?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const status = document.querySelector<HTMLElement>('#share-status')!;
        try {
          await navigator.clipboard.writeText(button.dataset.url!);
          status.textContent = 'Link copied.';
        } catch {
          status.textContent = 'Copy this address: ' + button.dataset.url;
        }
      });
    document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      const label = document.createElement('span');
      label.textContent =
        pre.dataset.language ||
        pre.querySelector('code')?.className.replace('language-', '') ||
        'Code';
      const button = document.createElement('button');
      button.textContent = 'Copy code';
      button.setAttribute('aria-label', 'Copy code block');
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent || '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select code to copy';
        }
      });
      toolbar.append(label, button);
      pre.before(toolbar);
    });
    document.querySelectorAll('.prose table').forEach((table) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'table-scroll';
      wrapper.tabIndex = 0;
      wrapper.setAttribute('role', 'region');
      wrapper.setAttribute('aria-label', 'Scrollable comparison table');
      table.before(wrapper);
      wrapper.append(table);
    });
  </script>
</BaseLayout>
