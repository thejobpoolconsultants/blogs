---
interface Props {
  steps: string[];
  caption: string;
}
const { steps, caption } = Astro.props;
---

<figure class="system-diagram">
  <div class="flow">
    {steps.map((step, i) => (
      <>
        <div class="flow-node">{step}</div>
        {i < steps.length - 1 && (
          <span class="flow-arrow" aria-hidden="true">
            →
          </span>
        )}
      </>
    ))}
  </div>
  <figcaption>{caption}</figcaption>
</figure>
