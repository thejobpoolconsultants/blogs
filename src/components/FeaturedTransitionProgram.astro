---
import { transitionProgram, programWebsite } from '../data/programs';
import { programExplainers } from '../data/program-explainers';
import { siteConfig } from '../utils/urls';
import ProgramIllustration from './ProgramIllustration.astro';
const demo = programExplainers.transition;
---

<section
  class="transition-feature"
  aria-labelledby="transition-program-title"
  data-pagefind-ignore
>
  <article
    class="transition-program"
    aria-labelledby="transition-program-title"
  >
    <div>
      <p class="eyebrow">Featured pathway · Find your starting point</p>
      <h2 id="transition-program-title">{transitionProgram.title}</h2>
      <p class="transition-tagline">{transitionProgram.tagline}</p>
      <p>{demo.intro}</p>
      <p class="program-learning">
        <strong>You’ll practice:</strong> AI foundations, working with documents
        and testing a first project.
      </p>
      <p class="program-audience">
        <strong>Best suited to:</strong> Beginners, career switchers and
        professionals moving into AI. Your background helps us find a suitable
        starting point.
      </p>
    </div>
    <ProgramIllustration kind="transition" number="00" />
    <div class="transition-project-actions">
      <p class="program-project">
        <strong>You could build</strong>
        {demo.build}
      </p>
      <div class="program-actions">
        <a
          class="text-link"
          href={programWebsite(transitionProgram.id)}
          target="_blank"
          rel="noopener noreferrer"
        >
          Explore Program <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button primary"
          href={siteConfig.enquiryForm}
          target="_blank"
          rel="noopener noreferrer"
        >
          Enquire About the AI Career Transition Program{' '}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </article>
</section>
