---
import type { TopicSequence } from '../../data/topic-sequences/types';
import { topicNavigation } from '../../utils/topic-navigation';
import { publishedArticles } from '../../utils/content';
import TopicReaderSidebar from './TopicReaderSidebar.astro';
interface Props {
  sequence: TopicSequence;
  selected?: string;
}
const { sequence, selected } = Astro.props;
const navigation = topicNavigation(sequence.id, await publishedArticles());
---

<TopicReaderSidebar navigation={navigation} selected={selected} />
