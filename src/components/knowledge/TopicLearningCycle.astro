---
import type { KnowledgeSection } from '../../data/topic-sequences/types';
interface Props {
  diagram: NonNullable<KnowledgeSection['diagram']>;
}
const { diagram } = Astro.props;
---

<figure class="knowledge-cycle" aria-labelledby="learning-cycle-title">
  <figcaption id="learning-cycle-title">{diagram.label}</figcaption>
  {diagram.stages.map((stage) => (
    <div class="cycle-stage">
      <p class="meta">{stage.label}</p>
      <ol aria-label={stage.label}>
        {stage.steps.map((step, index) => (
          <li>
            <span>{step}</span>
            {index < stage.steps.length - 1 && (
              <span class="cycle-arrow" aria-hidden="true">
                →
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>
  ))}
  <p class="cycle-caption">{diagram.caption}</p>
</figure>
<style>
  .knowledge-cycle {
    margin: 32px 0;
    padding: clamp(16px, 3vw, 28px);
    background: var(--background-secondary);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  figcaption {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin-bottom: 24px;
  }
  .cycle-stage + .cycle-stage {
    border-top: 1px solid var(--line);
    margin-top: 18px;
    padding-top: 18px;
  }
  .cycle-stage > p {
    color: var(--editorial-gold);
    margin-bottom: 12px;
  }
  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
  }
  li > span:first-child {
    padding: 10px 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .cycle-arrow {
    color: var(--accent);
  }
  .cycle-caption {
    font-size: 0.83rem;
    color: var(--muted);
    margin: 24px 0 0;
  }
</style>
