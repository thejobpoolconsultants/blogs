---
import {
  articleNeighbors,
  type TopicNavigation,
} from '../../utils/topic-navigation';
import { url } from '../../utils/urls';
interface Props {
  navigation: TopicNavigation;
  slug: string;
}
const { navigation, slug } = Astro.props;
const { previous, next } = articleNeighbors(navigation, slug);
---

<nav
  class="article-previous-next"
  aria-label={navigation.title + ' article sequence'}
  data-pagefind-ignore
>
  {previous ? (
    <a rel="prev" href={url(previous.path)}>
      <span class="meta">← Previous</span>
      <strong>{previous.title}</strong>
    </a>
  ) : (
    <span />
  )}
  {next ? (
    <a rel="next" href={url(next.path)}>
      <span class="meta">Next →</span>
      <strong>{next.title}</strong>
    </a>
  ) : (
    <span />
  )}
</nav>
