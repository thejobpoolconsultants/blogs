---
import type { TopicSequence } from '../../data/topic-sequences/types';
import {
  publicSequence,
  sectionPath,
  conceptCount,
} from '../../data/topic-sequences';
import { publishedArticles } from '../../utils/content';
import { url } from '../../utils/urls';
import TopicSidebar from './TopicSidebar.astro';
import TopicConceptList from './TopicConceptList.astro';
import TopicSectionPager from './TopicSectionPager.astro';
import TopicInsight from '../TopicInsight.astro';
import ConceptFlow from '../ConceptFlow.astro';
import ArticleList from '../ArticleList.astro';
import BuildMethod from '../BuildMethod.astro';
import '../../styles/topic-books.css';
import '../../styles/knowledge-books.css';
interface Props {
  sequence: TopicSequence;
  selected?: string;
}
const { sequence: source, selected } = Astro.props;
const articles = await publishedArticles();
const sequence = publicSequence(
  source,
  new Set(articles.map((article) => article.data.slug)),
);
const section = sequence.sections.find((section) => section.slug === selected);
const ownArticles = articles.filter(
  (article) => article.data.topic === sequence.id,
);
---

<nav class="breadcrumb topic-breadcrumb" aria-label="Breadcrumb">
  <a href={url()}>Home</a>
  <span>/</span>
  <a href={url('topics/')}>Topics</a>
  <span>/</span>
  {section ? (
    <>
      <a href={url(sectionPath(sequence))}>{sequence.title}</a>
      <span>/</span>
      <span aria-current="page">{section.title}</span>
    </>
  ) : (
    <span aria-current="page">{sequence.title}</span>
  )}
</nav>
<div
  class="topic-book book-ready knowledge-book"
  data-knowledge-book
  data-selected-section={selected || ''}
>
  <TopicSidebar sequence={sequence} selected={selected} />
  <div class="book-content" data-pagefind-body>
    <span hidden data-pagefind-filter="Topic" data-pagefind-meta="topic">
      {sequence.title}
    </span>
    {section ? (
      <>
        <div class="book-heading">
          <p class="eyebrow">
            {sequence.title} / {section.number}
          </p>
          <h1
            id="section-title"
            tabindex="-1"
            data-pagefind-meta={
              'title:' + sequence.title + ': ' + section.title
            }
          >
            {section.title}
          </h1>
          <p class="lead">{section.introduction}</p>
          <p class="meta book-section-number">
            Section {Number(section.number)} of {sequence.sections.length} ·{' '}
            {section.concepts.length} subtopics
          </p>
        </div>
        {section.insight && (
          <TopicInsight
            quote={{ lines: [section.insight] }}
            topic="Section"
            supporting={section.insightSupporting}
          />
        )}
        <p class="book-coverage-note knowledge-coverage-note">
          This is a knowledge index. Published titles open their articles; the
          remaining entries outline planned coverage.
        </p>
        {section.slug === 'projects-experiments' && (
          <>
            <BuildMethod />
            <p>
              <a class="text-link" href={url('topics/build/')}>
                Explore Build & Experiment ↗
              </a>
            </p>
          </>
        )}
        <TopicConceptList section={section} />
        <TopicSectionPager sequence={sequence} selected={section.slug} />
      </>
    ) : (
      <>
        <div class="book-heading">
          <p class="eyebrow">Knowledge book</p>
          <h1 data-pagefind-meta="title">{sequence.title}</h1>
        </div>
        <section aria-labelledby="overview-title" id="overview">
          <h2 class="book-panel-title" id="overview-title">
            Overview
          </h2>
          <p class="lead">{sequence.description}</p>
          <TopicInsight
            quote={{ lines: [sequence.insight] }}
            topic={sequence.title}
          />
          <p class="book-status meta">
            {sequence.sections.length} ordered sections ·{' '}
            {conceptCount(sequence)} concepts
            <br />
            {sequence.stages.join(' → ')}
          </p>
          <div class="book-actions">
            <a
              class="button book-start"
              href={url(sectionPath(sequence, sequence.sections[0].slug))}
            >
              Start from the beginning →
            </a>
            <a
              class="text-link"
              href={url('learn/' + sequence.learningPath.id + '/')}
            >
              {sequence.learningPath.title} ↗
            </a>
          </div>
          <ConceptFlow
            steps={sequence.flow}
            caption="A conceptual learning progression. These methods coexist; later ideas do not make earlier ones obsolete."
          />
          <div class="book-reading">
            <h3>Published in this topic</h3>
            <ArticleList articles={ownArticles} />
          </div>
          <nav
            class="knowledge-sequence-directory"
            aria-label="Jump to a section"
          >
            <h2>Follow the sequence</h2>
            <ol>
              {sequence.sections.map((chapter) => (
                <li id={chapter.slug}>
                  <a href={url(sectionPath(sequence, chapter.slug))}>
                    <span class="number">{chapter.number}</span>
                    <span>{chapter.title}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
          <p class="book-coverage-note">
            The sequence describes planned coverage, not a completed course. New
            articles can be added without changing the order.
          </p>
        </section>
        <script
          type="application/json"
          id="knowledge-legacy-links"
          set:html={JSON.stringify(
            Object.fromEntries(
              Object.entries(sequence.legacyHashes || {}).map(
                ([hash, target]) => [
                  hash,
                  url(sectionPath(sequence)) +
                    target +
                    (target.includes('/') ? '' : '/'),
                ],
              ),
            ),
          ).replace(/</g, '\\u003c')}
        ></script>
      </>
    )}
  </div>
</div>
<script>
  import { initKnowledgeBook } from '../../scripts/knowledge-book';
  document
    .querySelectorAll<HTMLElement>('[data-knowledge-book]')
    .forEach(initKnowledgeBook);
</script>
